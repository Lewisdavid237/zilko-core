    <script>
        let total = 0;

        async function injecterFluxMondial() {
            const ent = document.getElementById('idEntreprise').value;
            const msg = document.getElementById('messageClient').value;
            const key = document.getElementById('cleIdempotence').value;
            const out = document.getElementById('reponseServeur');
            const t0 = performance.now();

            try {
                const response = await fetch('/api/filtrer', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ entreprise_id: ent, message: msg, cle_idempotence: key })
                });
                const data = await response.json();
                document.getElementById('msLatency').textContent = `${(performance.now() - t0).toFixed(2)} ms`;

                if (response.status === 201) {
                    total++;
                    document.getElementById('statTotal').textContent = total;
                    rafraichirLogsMaintenance();
                }
                out.textContent = JSON.stringify(data, null, 4);
            } catch {
                out.textContent = "Erreur de liaison locale avec app.py.";
            }
        }

        async function rafraichirLogsMaintenance() {
            try {
                const response = await fetch('/api/maintenance/logs');
                const logs = await response.json();
                const container = document.getElementById('journalMaintenance');
                if(logs.length > 0) {
                    container.innerHTML = logs.map(l => `<div class="text-zinc-400 border-b border-zinc-900 pb-1">${l}</div>`).join('');
                }
            } catch {}
        }

