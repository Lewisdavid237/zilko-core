from flask import Flask, request, jsonify, render_template_string
import hashlib
import re
import json
import os
import threading
from datetime import datetime

app = Flask(__name__)

# =====================================================================
# 🏛️ SYSTÈME AUTONOME D'AUTORÉPARATION ET MAINTENANCE AUTOMATIQUE
# =====================================================================
DB_FILE = "zilko_vault.json"
DB_BACKUP = "zilko_vault.backup.json"
SIX_MOIS_EN_JOURS = 182

verrou_global = threading.Lock()
registre_memoire = {}
logs_maintenance_auto = []

def verifier_et_autoreparer_systeme():
    """ Inspecte, valide et répare automatiquement la base de données sans intervention humaine """
    global registre_memoire, logs_maintenance_auto
    with verrou_global:
        horodatage = datetime.now().strftime("%H:%M:%S")
        
        if not os.path.exists(DB_FILE):
            registre_memoire = {}
            return

        try:
            with open(DB_FILE, "r", encoding="utf-8") as f:
                donnees = json.load(f)
                if not isinstance(donnees, dict):
                    raise ValueError("Structure corrompue")
                registre_memoire = donnees
        except Exception:
            logs_maintenance_auto.append(f"[{horodatage}] 🔧 ANOMALIE DÉTECTÉE : Fichier altéré. Lancement de la maintenance automatique.")
            
            if os.path.exists(DB_BACKUP):
                try:
                    with open(DB_BACKUP, "r", encoding="utf-8") as f_backup:
                        registre_memoire = json.load(f_backup)
                    with open(DB_FILE, "w", encoding="utf-8") as f_main:
                        json.dump(registre_memoire, f_main, ensure_ascii=False, indent=4)
                    logs_maintenance_auto.append(f"[{horodatage}] ✅ SUCCÈS : Base principale restaurée automatiquement depuis le backup.")
                    return
                except:
                    pass
            
            logs_maintenance_auto.append(f"[{horodatage}] ⚠️ SÉCURITÉ : Réinitialisation à chaud pour maintenir l'application en ligne.")
            registre_memoire = {}
            with open(DB_FILE, "w", encoding="utf-8") as f_new:
                json.dump(registre_memoire, f_new)

def sauvegarder_base_redondante():
    try:
        with open(DB_FILE, "w", encoding="utf-8") as f:
            json.dump(registre_memoire, f, ensure_ascii=False, indent=4)
        with open(DB_BACKUP, "w", encoding="utf-8") as f_backup:
            json.dump(registre_memoire, f_backup, ensure_ascii=False, indent=4)
    except Exception as e:
        print(f"Erreur d'écriture disque : {str(e)}")

def hacher_sha256(texte):
    return hashlib.sha256(texte.encode('utf-8')).hexdigest()

